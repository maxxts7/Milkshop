# ---------------------------------------------------------------
# Khanams Grassfed — environment variables
# Copy to .env.local for local dev; set the same keys in Netlify
# under Site settings → Environment variables.
# ---------------------------------------------------------------

# REQUIRED — Neon Postgres connection string (the pooled one).
# Get it free at https://neon.tech, or use the Neon extension in Netlify.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# REQUIRED — signs customer and admin login cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-64-character-random-hex-string"

# OPTIONAL — SMS provider for phone OTP login.
# Leave blank and OTP codes print to the server log instead (fine for testing).
# Sign up at https://msg91.com when you're ready to go live.
SMS_PROVIDER=""              # "" (console) | "msg91"
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""

# OPTIONAL — email alerts when an order comes in.
# Leave blank and alerts print to the server log. Free tier at https://resend.com
RESEND_API_KEY=""
ORDER_ALERT_EMAIL="manuxtmail@gmail.com"
ORDER_ALERT_FROM="orders@khanamsgrassfed.com"

# OPTIONAL — WhatsApp alerts when an order comes in, via the WhatsApp Cloud API.
# Leave blank and alerts print to the server log. The number they are sent TO is
# the WhatsApp number in Admin → Settings, not an environment variable.
# Both keys come from https://developers.facebook.com → your WhatsApp app.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"

# Public site URL — used in emails and share links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
